{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Traceable model-authored interview review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "reviews"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "status": {
      "enum": [
        "pending",
        "partial",
        "complete"
      ]
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "occurrence_id",
          "reference",
          "status",
          "label",
          "reason",
          "model",
          "reviewed_at"
        ],
        "properties": {
          "occurrence_id": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "raw_path",
              "line_start",
              "source_section_sha256",
              "quote"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "raw_path": {
                "type": "string",
                "minLength": 1
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "source_section_sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "status": {
            "enum": [
              "reviewed",
              "needs_review"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "domains": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "intents": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question_id",
                "quote",
                "distinction"
              ],
              "properties": {
                "question_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "distinction": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "reviewed"
                }
              }
            },
            "then": {
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "needs_review"
                }
              }
            },
            "then": {
              "properties": {
                "label": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "source_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_ids",
          "reason",
          "verification_urls"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "verification_urls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_commit",
        "source_ids",
        "record_count",
        "record_ids_sha256"
      ],
      "properties": {
        "baseline_commit": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        },
        "record_ids_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "reviews": {
            "items": {
              "required": [
                "domains",
                "intents"
              ]
            }
          }
        },
        "required": [
          "source_groups",
          "snapshot"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "reviews": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "domains"
                    ]
                  },
                  {
                    "required": [
                      "intents"
                    ]
                  }
                ]
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "source_groups"
              ]
            },
            {
              "required": [
                "snapshot"
              ]
            }
          ]
        }
      }
    }
  ]
}
